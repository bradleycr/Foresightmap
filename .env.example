# -----------------------------------------------------------------------------
# Foresight Map – environment template
# Copy to .env.local (or .env) and fill in real values. Never commit secrets.
# Scripts (sync:sheet, sync:events, migrate:sheet, server) load .env.local automatically.
# -----------------------------------------------------------------------------
#
# ----- Quick: get the app loading from the Google Sheet -----------------------
# 1. Google Cloud Console: enable "Google Sheets API", create an API key (restrict to Sheets API).
# 2. Share your spreadsheet: Share → "Anyone with the link" can VIEW (required for API key).
# 3. Below: set SPREADSHEET_ID (from the sheet URL .../d/THIS_PART/edit) and GOOGLE_SHEETS_API_KEY.
# 4. Run: pnpm dev (app + API). GET /api/database will read from the sheet.
#    If the sheet has no data yet, run: GOOGLE_SERVICE_ACCOUNT_KEY='...' pnpm run migrate:sheet
#    (service account needs Editor access; see docs/SHEETS_SYNC.md).
# -----------------------------------------------------------------------------

# ----- Frontend (Vite) – exposed to client with VITE_ prefix -----------------
# Optional: Base path for deployment (e.g. GitHub Pages subpath). Default: /
# VITE_BASE_PATH=/

# Optional: API on another host (partner / BFF). Origin only, no trailing slash.
# Built app will call https://YOUR_HOST/api/... — enable CORS on that API for the SPA origin.
# VITE_API_ORIGIN=https://api.your-company.com

# Shared calendar explainer text (Calendar page). Invite this email to add events.
# VITE_CALENDAR_INVITE_EMAIL=user@foresight.com

# Optional: Supabase (conceptual; see src/INTEGRATION.md). Not wired by default.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ----- Optional: extra gate on RSVP / check-in POST (skip unless you need it) -----
# FORESIGHT_PUBLIC_WRITE_SECRET=...
# VITE_FORESIGHT_WRITE_SECRET=...   # same value; baked into client build

# ----- Server (Express) ------------------------------------------------------
# Port for the API server (default: 3001)
PORT=3001

# Node environment: development | production (affects error messages)
NODE_ENV=development

# Local mock fallback (no extra env needed):
# If neither GOOGLE_SHEETS_API_KEY nor GOOGLE_SERVICE_ACCOUNT_KEY / GOOGLE_APPLICATION_CREDENTIALS is set,
# `pnpm dev` automatically runs file-backed local mock storage under:
#   mock/database.local.json   (main editable database)
#   mock/auth.local.json       (directory auth state)
#   mock/luma-events.local.json (seeded with 2 mock Luma events)

# ----- Google Sheet as database (see docs/SHEETS_SYNC.md) --------------------
# The app always uses the sheet when credentials are set. USE_SHEET_AS_DATABASE is not used — do not set it.
# Spreadsheet ID from the sheet URL: .../d/SPREADSHEET_ID/edit
# Keep the production sheet PRIVATE. Do not commit real IDs or keys.
# SPREADSHEET_ID=your-spreadsheet-id

# Read from sheet (required for GET /api/database with an API key).
# Prefer a service account + private sheet (Editor share) over "anyone with the link".
# Create key in Google Cloud Console → APIs & Services → Credentials → Create API key → restrict to Google Sheets API.
# GOOGLE_SHEETS_API_KEY=your-google-api-key
# (Some scripts also accept GOOGLE_API_KEY as an alias.)

# Google Calendar (shared node calendars):
# - IDs are required for /api/calendar-events to read each node calendar.
# - Read auth can use GOOGLE_CALENDAR_API_KEY, GOOGLE_API_KEY, GOOGLE_SHEETS_API_KEY, or service account.
# GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key
# GOOGLE_CALENDAR_ID_BERLIN=your-berlin-calendar-id@group.calendar.google.com
# GOOGLE_CALENDAR_ID_SF=your-sf-calendar-id@group.calendar.google.com
# GOOGLE_CALENDAR_ID_GLOBAL=your-global-calendar-id@group.calendar.google.com

# Write to sheet: service account. Share the sheet with the service account email as Editor.
# Used by: profile save, member-register, pnpm migrate:sheet, api/rsvps, etc.
# Option A: path to key file (local or Docker). Put the JSON file in keys/ (see keys/README.md).
# GOOGLE_APPLICATION_CREDENTIALS=./keys/service-account.json
# Option B: JSON string (required for Vercel; also works for local/Docker)
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...",...}

# ----- Luma API (see docs/LUMA_INTEGRATION.md) ---------------------------------
# Used by: pnpm sync:events. Requires Luma Plus subscription.
# API key: Luma calendar → Settings → Developer
# LUMA_API_KEY=your-luma-api-key
# Calendar API ID: from Luma calendar settings or URL
# LUMA_CALENDAR_API_ID=cal-xxxxxxxxxxxx

# ----- Signal Bot (check-in via Signal group) ---------------------------------
# URL of the signal-cli-rest-api container (Docker self-host).
# SIGNAL_API_URL=http://localhost:8080

# Phone number registered with signal-cli (E.164 format, e.g. +491701234567).
# SIGNAL_NUMBER=+491701234567

# Base64-encoded Signal group ID. Messages outside this group are ignored.
# SIGNAL_GROUP_ID=base64groupid==

# Node slug that this Signal group maps to ("berlin" or "sf").
# SIGNAL_NODE_SLUG=berlin

# Polling interval in milliseconds (default: 5000).
# SIGNAL_POLL_INTERVAL_MS=5000

# Set to 1 to log each poll inbox size (no message bodies).
# SIGNAL_LOG_VERBOSE=1

# ----- Optional integrations (e.g. Edge Functions) ----------------------------
# See src/INTEGRATION.md for optional backends. Password reset uses mailto +
# `pnpm reset:link -- "Full Name"` (no outbound email required).
# CLAIM_BASE_URL=https://atlas.foresight.org
